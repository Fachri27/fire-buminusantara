# Templat .env di server (stack dir /srv/fire). Disalin bootstrap.sh, diisi
# secret acak oleh gen-secrets.sh, sisanya diisi manusiawi oleh operator.
# Nilai kosong → gen-secrets.sh mengisi; kunci "manusiawi" dicetak provision.sh.

# Tag image yang berjalan — digerakkan oleh CI (remote-deploy.sh set_tag).
WEB_TAG=latest

# Database utama (MariaDB milik CMS Laravel, berjalan di host).
# host.docker.internal = host dari dalam container (lihat extra_hosts di compose).
DATABASE_URL=mysql://user:password@host.docker.internal:3306/pasopati

# Kunci penandatanganan cookie sesi CMS — diisi otomatis (openssl rand).
SESSION_SECRET=

# MinIO untuk berkas media
MINIO_ENDPOINT=http://host.docker.internal:9000
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_BUCKET=fire

# Base URL media lama dari CMS Laravel
NEXT_PUBLIC_MEDIA_URL=

# Database PostGIS lokasi (Simontini) — hanya-baca; kosongkan untuk mematikan
GEO_DATABASE_URL=
GEO_LOCATION_TABLE=
GEO_NAME_COLUMN=
GEO_LAT_COLUMN=
GEO_LNG_COLUMN=
GEO_SEARCH_COLUMNS=

# Cloudflare Turnstile — kosongkan keduanya untuk melewati verifikasi
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Opsional: nama container MariaDB di host untuk dump pra-deploy
# (remote-deploy.sh). Kosong = lewati dump.
DB_CONTAINER=