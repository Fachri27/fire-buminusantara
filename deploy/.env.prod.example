# Templat .env di server (stack dir /srv/fire). Disalin bootstrap.sh, diisi
# secret acak oleh gen-secrets.sh, sisanya diisi manusiawi oleh operator.
# Nilai kosong → gen-secrets.sh mengisi; kunci "manusiawi" dicetak provision.sh.

# Tag image yang berjalan — digerakkan oleh CI (remote-deploy.sh set_tag).
WEB_TAG=latest

# Database utama (MariaDB milik CMS Laravel). Host tergantung cara MariaDB
# berjalan: container di jaringan "shared" → nama containernya; proses di host
# → bind-address MariaDB harus mendengarkan alamat bridge (172.17.0.1) lalu
# pakai host itu di sini.
DATABASE_URL=mysql://user:password@NAMA-CONTAINER-DB:3306/pasopati

# Kunci penandatanganan cookie sesi CMS — diisi otomatis (openssl rand).
SESSION_SECRET=

# MinIO untuk berkas media — lewat jaringan docker "shared", pakai nama
# container/layanan (bukan host.docker.internal: port 127.0.0.1 tidak bisa
# dijangkau dari container).
MINIO_ENDPOINT=http://minio:9000
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_BUCKET=fire

# Base URL media lama dari CMS Laravel
NEXT_PUBLIC_MEDIA_URL=

# Database PostGIS lokasi (Simontini) — hanya-baca; kosongkan untuk mematikan
GEO_DATABASE_URL=
GEO_LOCATION_TABLE=
GEO_NAME_COLUMN=
GEO_LAT_COLUMN=
GEO_LNG_COLUMN=
GEO_SEARCH_COLUMNS=

# Cloudflare Turnstile — WAJIB di produksi: secret kosong = setiap kiriman
# berkaptcha (komentar, laporan tamu) ditolak. Kosong hanya melewati verifikasi
# di mode dev.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Semua asal yang melayani situs, dipisah koma (passkey CMS + hostname token
# Turnstile). Di produksi token dari host yang tak terdaftar DITOLAK — wajib
# memuat host API aplikasi mobile (halaman /api/mobile/captcha), mis.
# https://laporin.app,https://fire.nusantara.earth. Kosong = asal
# NEXT_PUBLIC_SITE_URL saat build saja.
WEBAUTHN_ORIGIN=

# Jumlah reverse proxy tepercaya di depan aplikasi (nginx host di luar stack
# ini → 1). Menentukan berapa dalam X-Forwarded-For boleh dipercaya untuk
# membaca IP asli pengunjung — dipakai /api/cuaca-lokal (lokasi + suhu panel
# kiri landing karhutla), Turnstile & pencatatan moderasi. 0 = header
# diabaikan (IP tak terbaca → cuaca jatuh ke cadangan DKI Jakarta untuk semua
# pengunjung). nginx host wajib meneruskan:
#   proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
TRUSTED_PROXY_HOPS=1

# Token ECMWF CAMS ARCO (lapisan sebaran asap + kualitas udara). Kosong =
# kedua lapisan padam (503); tidak ada lagi token cadangan di kode.
CAMS_ZARR_TOKEN=

# Bearer token kontainer cron → /api/cron/warm-asap — diisi otomatis (openssl
# rand). Kosong = rute menjawab 401 di produksi dan data asap/hotspot basi.
CRON_SECRET=

# Opsional: nama container MariaDB di host untuk dump pra-deploy
# (remote-deploy.sh). Kosong = lewati dump.
DB_CONTAINER=

# ── Aplikasi mobile Lapor Karhutla (/api/mobile/*) ── lihat .env.example.
# Semuanya diisi manusia (provision.sh). GOOGLE_*/APPLE_BUNDLE_ID/LIVEKIT_*
# kosong = rute terkait dijawab 503; APPLE_TEAM_ID/KEY_ID/PRIVATE_KEY kosong =
# token Apple tidak dicabut saat warga menghapus akun (App Store 5.1.1(v)).
GOOGLE_WEB_CLIENT_ID=
APPLE_BUNDLE_ID=earth.nusantara.fire.lapor,earth.nusantara.fire.lapor.preview
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=
# Kunci segel refresh_token Apple — diisi otomatis (openssl rand). JANGAN
# diganti setelah terisi: token lama tak bisa dibuka lagi.
APPLE_TOKEN_SECRET=
# LIVEKIT_API_SECRET SENGAJA tidak diisi gen-secrets.sh: harus sama dengan
# kunci di server LiveKit. Server di box ini (layanan livekit compose) membaca
# pasangan yang sama: LIVEKIT_URL=wss://live.nusantara.earth, API_KEY bebas
# (mis. APIfire), SECRET ≥ 32 karakter (openssl rand -hex 24).
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
