# Database utama (MariaDB via adapter @prisma/adapter-mariadb)
DATABASE_URL=mysql://user:password@127.0.0.1:3306/pasopati

# Kunci penandatanganan cookie sesi CMS (wajib; string acak, mis. `openssl rand -base64 32`)
SESSION_SECRET=

# MinIO untuk berkas media (route /media mengambil objek dengan kredensial server)
MINIO_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=fire

# Base URL media lama dari CMS Laravel (path yang tidak berawalan "fire/")
NEXT_PUBLIC_MEDIA_URL=

# Akar absolut situs untuk metadata OG (og:image/og:url pratinjau WhatsApp dsb.)
NEXT_PUBLIC_SITE_URL=https://laporin.app

# Asal situs untuk passkey (masuk sidik jari / wajah). Passkey terikat pada
# domain ini. Kosong = asal NEXT_PUBLIC_SITE_URL. Pengembangan: http://localhost:3000
# Beberapa domain: pisahkan dengan koma, mis. https://a.id,https://b.id
WEBAUTHN_ORIGIN=

# Database PostGIS lokasi (Simontini) — terpisah, hanya-baca. Kosongkan kolom-kolomnya untuk mematikan pencarian lokasi.
GEO_DATABASE_URL=
GEO_LOCATION_TABLE=
GEO_NAME_COLUMN=
GEO_LAT_COLUMN=
GEO_LNG_COLUMN=
GEO_SEARCH_COLUMNS=

# Cloudflare Turnstile. Kosong = verifikasi dilewati DI PENGEMBANGAN saja; di
# produksi (NODE_ENV=production) secret kosong berarti SEMUA kiriman ditolak
# (fail-closed), jadi wajib diisi sebelum rilis.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Jumlah reverse proxy tepercaya di depan aplikasi. Menentukan berapa dalam
# X-Forwarded-For boleh dipercaya untuk membaca IP asli pengunjung (dipakai
# Turnstile, pencatatan moderasi, dan batas laju per IP). 0 = tak ada proxy,
# header diabaikan (IP tak dicatat, tapi tak bisa dipalsukan). Di belakang
# satu proxy (nginx, Vercel, dsb.) setel 1.
# WAJIB di produksi: isi dengan jumlah proxy tepercaya di depan container.
# Tanpa IP, batas laju per IP jatuh ke SATU ember bersama untuk semua
# pengunjung (10× lebih longgar, lib/batas-laju.ts) dan server mencatat
# peringatan "ip-tak-terbaca" paling sering sejam sekali.
TRUSTED_PROXY_HOPS=0

# Secret untuk memicu cron job background (mis. /api/cron/warm-asap)
# Wajib diisi di produksi untuk mencegah pemanggilan tidak sah.
CRON_SECRET=

# Kredensial & URL ECMWF CAMS ARCO Datastore (Zarr Sebaran Asap OMAOD 550nm)
# Token proyek akses ARCO — WAJIB (tak ada token cadangan di kode). Kosong = lapisan
# Aerosol & Angin padam: metadata cadangan, frame /api/sebaran-asap & /api/udara 503.
CAMS_ZARR_TOKEN=
# CAMS_ZARR_BASE_URL=https://arco.datastores.ecmwf.int/cadl-arco-time-001/arco/cams_global_atmospheric_composition_forecasts/sfc-multiforecast/timeChunked.zarr

# MAP_KEY NASA FIRMS (opsional, gratis: firms.modaps.eosdis.nasa.gov/api/map_key) — titik MODIS dari API area ditambahkan ke berkas wilayah. Kosong = berkas wilayah saja.
FIRMS_MAP_KEY=

# Redis Cache terpusat untuk frame satelit sebaran asap & metadata
# Opsional: Kosongkan untuk fallback otomatis ke in-memory RAM proses
REDIS_URL=redis://127.0.0.1:6379
# Juga dipakai batas laju laporan & login (lib/batas-laju.ts); tanpa Redis
# penghitungnya di memori proses (benar untuk satu container saja).

# Alarm galat server (opsional): URL webhook Slack atau Discord. Galat simpan
# laporan/kejadian dan galat yang lolos ke Next dikirim ke sini, maks. sekali
# per 5 menit per jenis. Kosong = hanya log container.
ALERT_WEBHOOK_URL=
# ── Aplikasi mobile Lapor Karhutla (/api/mobile/*) ───────────────────────────
# OAuth client Google tipe "Web application" — SAMA dengan
# EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID di aplikasi (aud idToken). Kosong = masuk
# dengan Google dari aplikasi dijawab 503.
GOOGLE_WEB_CLIENT_ID=
# Bundle ID iOS aplikasi (aud token Sign in with Apple), boleh beberapa dipisah
# koma — build produksi dan varian preview (APP_VARIANT=preview). Kosong = 503.
APPLE_BUNDLE_ID=earth.nusantara.fire.lapor,earth.nusantara.fire.lapor.preview
# Kunci "Sign in with Apple" dari developer.apple.com (Keys, berkas .p8): untuk
# mencabut token Apple saat warga menghapus akun (App Store 5.1.1(v)). Kunci
# PEM boleh satu baris dengan \n. Kosong = token tidak disimpan/dicabut.
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=
# Kunci segel AES-256-GCM refresh_token Apple di basis data (string acak, mis.
# `openssl rand -base64 32`; gen-secrets.sh mengisinya otomatis). Kosong =
# token tidak disimpan. JANGAN diganti setelah terisi: token yang tersegel
# kunci lama tak bisa dibuka lagi, jadi tak bisa dicabut saat akun dihapus.
APPLE_TOKEN_SECRET=
# Siaran langsung (LiveKit Cloud: wss://<proyek>.livekit.cloud, atau self-host
# dengan TLS + UDP 50000–60000). Kosong = rute siaran dijawab 503.
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
# HANYA pengembangan: 1 = POST /api/mobile/masuk/uji aktif (tidak pernah aktif
# saat NODE_ENV=production).
MOBILE_MASUK_UJI=
